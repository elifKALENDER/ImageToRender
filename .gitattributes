# Normalize line endings: LF in the repo, native on checkout for text
* text=auto

# Source & config: always LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf

# Windows scripts: CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.zip  binary
*.safetensors binary
*.pt   binary
*.ckpt binary
*.bin  binary
